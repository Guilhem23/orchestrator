{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-fabric.example/schemas/orchestrator-v4-architecture-review-record.json",
  "title": "Slice Orchestrator v4 Architecture Review Record",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "project_id",
    "slice",
    "plan_revision",
    "plan_digest",
    "scope_manifest_digest",
    "base_commit_oid",
    "reviewer_identity",
    "reviewer_role",
    "reviewer_assignment_id",
    "reviewer_execution_id",
    "review_artifact_digest",
    "result",
    "blocking_findings",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "record_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "slice": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 0
    },
    "plan_digest": {
      "$ref": "#/$defs/sha256"
    },
    "scope_manifest_digest": {
      "$ref": "#/$defs/sha256"
    },
    "base_commit_oid": {
      "$ref": "#/$defs/gitOid"
    },
    "reviewer_identity": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_role": {
      "const": "ARCHITECTURE_REVIEWER"
    },
    "reviewer_assignment_id": {
      "type": "string",
      "format": "uuid"
    },
    "reviewer_execution_id": {
      "type": "string",
      "minLength": 1
    },
    "review_artifact_digest": {
      "$ref": "#/$defs/sha256"
    },
    "result": {
      "enum": [
        "APPROVED",
        "BLOCKED"
      ]
    },
    "blocking_findings": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "APPROVED"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "blocking_findings": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "blocking_findings": {
            "minimum": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(sha1:[a-f0-9]{40}|sha256:[a-f0-9]{64})$"
    }
  }
}
