{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-fabric.example/schemas/orchestrator-v4-assignment.json",
  "title": "Slice Orchestrator v4 Role Assignment",
  "type": "object",
  "required": [
    "schema_version",
    "assignment_id",
    "project_id",
    "slice",
    "run_id",
    "run_generation",
    "role",
    "principal_id",
    "execution_id",
    "plan_revision",
    "input_bundle_digest",
    "capability_profile",
    "one_use",
    "status",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "assignment_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "slice": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_generation": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "enum": [
        "PLANNER",
        "IMPLEMENTER",
        "ARCHITECTURE_REVIEWER",
        "ADVERSARIAL_REVIEWER",
        "GOVERNANCE_AGENT"
      ]
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "vendor_thread_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_record_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "review_request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "input_bundle_digest": {
      "$ref": "#/$defs/sha256"
    },
    "capability_profile": {
      "enum": [
        "PLAN_PRIVATE_OUTPUT",
        "WORKSPACE_WRITE_NO_GIT_NO_CONTROL",
        "READ_ONLY_PLAN_PRIVATE_OUTPUT",
        "READ_ONLY_CANDIDATE_PRIVATE_OUTPUT",
        "GOVERNANCE_WORKSPACE_ONLY"
      ]
    },
    "one_use": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "CONSUMED",
        "COMPLETED",
        "EXPIRED",
        "UNAVAILABLE",
        "REVOKED"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
