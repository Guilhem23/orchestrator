{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-fabric.example/schemas/orchestrator-v4-candidate-record.json",
  "title": "Slice Orchestrator v4 Candidate Record",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "project_id",
    "slice",
    "run_id",
    "implementation_assignment_id",
    "captured_at",
    "workspace_revision",
    "changed_paths_digest",
    "scope_check_digest",
    "protected_path_check_digest",
    "test_receipt_ids",
    "evidence_set_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "slice": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "implementation_assignment_id": {
      "type": "string",
      "format": "uuid"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace_revision": {
      "$ref": "#/$defs/workspaceRevision"
    },
    "changed_paths_digest": {
      "$ref": "#/$defs/sha256"
    },
    "scope_check_digest": {
      "$ref": "#/$defs/sha256"
    },
    "protected_path_check_digest": {
      "$ref": "#/$defs/sha256"
    },
    "test_receipt_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "evidence_set_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(sha1:[a-f0-9]{40}|sha256:[a-f0-9]{64})$"
    },
    "workspaceRevision": {
      "type": "object",
      "required": [
        "repository_id",
        "object_format",
        "base_commit_oid",
        "candidate_tree_oid",
        "plan_revision",
        "plan_digest",
        "scope_manifest_digest",
        "test_plan_digest",
        "policy_bundle_digest",
        "workspace_revision_digest"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "object_format": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "base_commit_oid": {
          "$ref": "#/$defs/gitOid"
        },
        "candidate_tree_oid": {
          "$ref": "#/$defs/gitOid"
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 0
        },
        "plan_digest": {
          "$ref": "#/$defs/sha256"
        },
        "scope_manifest_digest": {
          "$ref": "#/$defs/sha256"
        },
        "test_plan_digest": {
          "$ref": "#/$defs/sha256"
        },
        "policy_bundle_digest": {
          "$ref": "#/$defs/sha256"
        },
        "workspace_revision_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
