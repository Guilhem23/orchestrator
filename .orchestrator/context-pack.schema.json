{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-fabric.example/schemas/orchestrator-v4-context-pack.json",
  "title": "Slice Orchestrator v4 Deterministic Worker Context Pack",
  "description": "Immutable control-plane-generated, assignment-bound context. Workers receive read-only role views.",
  "type": "object",
  "required": [
    "schema_version",
    "context_pack_id",
    "context_pack_digest",
    "project_id",
    "slice",
    "run_id",
    "run_generation",
    "event_sequence",
    "role",
    "assignment_id",
    "product_goal",
    "product_objectives",
    "slice_objective",
    "approved_plan",
    "scope_manifest",
    "test_plan",
    "decisions",
    "adrs",
    "lessons",
    "risks",
    "open_questions",
    "work_item",
    "repository_facts",
    "previous_findings",
    "selection_manifest",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "context_pack_id": {
      "type": "string",
      "format": "uuid"
    },
    "context_pack_digest": {
      "$ref": "#/$defs/sha256",
      "description": "Digest of canonical pack content excluding this field."
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "slice": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_generation": {
      "type": "integer",
      "minimum": 1
    },
    "event_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "role": {
      "enum": [
        "PLANNER",
        "PO_SM_SUPERVISOR",
        "IMPLEMENTER",
        "ADVERSARIAL_REVIEWER",
        "REMEDIATOR",
        "EXPLORER",
        "ARCHITECTURE_CHALLENGER",
        "GOVERNANCE_AGENT"
      ]
    },
    "assignment_id": {
      "type": "string",
      "format": "uuid"
    },
    "product_goal": {
      "$ref": "#/$defs/recordRef"
    },
    "product_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/recordRef"
      }
    },
    "slice_objective": {
      "oneOf": [
        {
          "$ref": "#/$defs/recordRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "approved_plan": {
      "oneOf": [
        {
          "$ref": "#/$defs/recordRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_manifest": {
      "oneOf": [
        {
          "$ref": "#/$defs/recordRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "test_plan": {
      "oneOf": [
        {
          "$ref": "#/$defs/recordRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selectedRef"
      }
    },
    "adrs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selectedRef"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selectedRef"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selectedRef"
      }
    },
    "work_item": {
      "oneOf": [
        {
          "$ref": "#/$defs/recordRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "repository_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "statement",
          "evidence"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/sourceRef"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "previous_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recordRef"
      }
    },
    "selection_manifest": {
      "type": "object",
      "required": [
        "selector_version",
        "policy_bundle_digest",
        "product_memory_snapshot_digest",
        "included_record_ids",
        "excluded_categories",
        "selection_reasons"
      ],
      "properties": {
        "selector_version": {
          "type": "string",
          "minLength": 1
        },
        "policy_bundle_digest": {
          "$ref": "#/$defs/sha256"
        },
        "product_memory_snapshot_digest": {
          "$ref": "#/$defs/sha256"
        },
        "included_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selection_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "record_id",
              "reason"
            ],
            "properties": {
              "record_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "derived_summary": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional non-authoritative summary. Exact records remain authoritative inputs."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recordRef": {
      "type": "object",
      "required": [
        "record_type",
        "record_id",
        "record_digest"
      ],
      "properties": {
        "record_type": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "record_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "selectedRef": {
      "type": "object",
      "required": [
        "record",
        "relevance_reason"
      ],
      "properties": {
        "record": {
          "$ref": "#/$defs/recordRef"
        },
        "relevance_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sourceRef": {
      "type": "object",
      "required": [
        "path",
        "section",
        "content_digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
