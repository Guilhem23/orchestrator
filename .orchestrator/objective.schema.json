{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-fabric.example/schemas/orchestrator-v4-objective.json",
  "title": "Slice Orchestrator v4 Objective Record",
  "type": "object",
  "required": [
    "schema_version",
    "objective_id",
    "slice",
    "description",
    "source_requirements",
    "acceptance_predicates",
    "dependencies",
    "status",
    "created_at",
    "revision"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "objective_id": {
      "type": "string",
      "pattern": "^S[0-9]+-O[0-9]+$"
    },
    "slice": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "acceptance_predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "predicate_id",
          "kind",
          "expression"
        ],
        "properties": {
          "predicate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "test_pass",
              "file_exists",
              "schema_match",
              "benchmark_met",
              "evidence_exists",
              "protected_path_intact"
            ]
          },
          "expression": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S[0-9]+-O[0-9]+$"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "IN_PROGRESS",
        "SATISFIED",
        "FAILED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
