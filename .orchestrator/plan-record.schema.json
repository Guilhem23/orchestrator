{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-fabric.example/schemas/orchestrator-v4-plan-record.json",
  "title": "Slice Orchestrator v4 Plan Record",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "project_id",
    "slice",
    "plan_revision",
    "plan_content_digest",
    "scope_manifest_digest",
    "test_plan",
    "test_plan_digest",
    "base_commit_oid",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "record_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "slice": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 0
    },
    "plan_content_digest": {
      "$ref": "#/$defs/sha256"
    },
    "scope_manifest_digest": {
      "$ref": "#/$defs/sha256"
    },
    "test_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "command",
          "working_directory",
          "required",
          "expected_exit_code",
          "allow_skips"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "working_directory": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "const": true
          },
          "expected_exit_code": {
            "const": 0
          },
          "allow_skips": {
            "const": false
          }
        },
        "additionalProperties": false
      }
    },
    "test_plan_digest": {
      "$ref": "#/$defs/sha256",
      "description": "Digest of canonical test_plan content; the digest field itself is excluded."
    },
    "base_commit_oid": {
      "$ref": "#/$defs/gitOid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(sha1:[a-f0-9]{40}|sha256:[a-f0-9]{64})$"
    }
  }
}
