{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-fabric.example/schemas/orchestrator-v4-product-objective.json",
  "title": "Slice Orchestrator v4 Product Objective",
  "description": "A bounded product outcome between Product Goal and run-scoped Slice Objective.",
  "type": "object",
  "required": [
    "schema_version",
    "objective_id",
    "goal_ids",
    "outcome_statement",
    "product_value",
    "source",
    "success_criteria",
    "related_roadmap_elements",
    "affected_slices",
    "dependencies",
    "non_goals",
    "risk_ids",
    "confidence",
    "status",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "objective_id": {
      "type": "string",
      "pattern": "^PO-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "goal_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PG-[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "outcome_statement": {
      "type": "string",
      "minLength": 1
    },
    "product_value": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "statement",
          "evidence_kind",
          "evidence_references",
          "is_acceptance_authority"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_kind": {
            "enum": [
              "DETERMINISTIC",
              "MEASURED",
              "QUALITATIVE"
            ]
          },
          "evidence_references": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/recordRef"
            }
          },
          "is_acceptance_authority": {
            "const": false
          }
        },
        "additionalProperties": false
      }
    },
    "related_roadmap_elements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affected_slices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(S[0-9]+|UI-[0-9]+)$"
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PO-[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^RISK-[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "SATISFIED",
        "DEFERRED",
        "RETIRED"
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRef": {
      "type": "object",
      "required": [
        "path",
        "section",
        "content_digest",
        "authority_reference"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "$ref": "#/$defs/sha256"
        },
        "authority_reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "recordRef": {
      "type": "object",
      "required": [
        "record_type",
        "record_id",
        "record_digest"
      ],
      "properties": {
        "record_type": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "record_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
