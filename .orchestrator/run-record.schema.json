{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-fabric.example/schemas/orchestrator-v4-run-record.json",
  "title": "Slice Orchestrator v4 Persistent Slice Run",
  "description": "Immutable identity and initial intent for the primary orchestration unit created by `slice run <slice>`.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "run_generation",
    "project_id",
    "slice",
    "requested_lifecycle",
    "base_commit_oid",
    "policy_bundle_digest",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_generation": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "slice": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "requested_lifecycle": {
      "const": "PLAN_ARCHITECTURE_REVIEW_IMPLEMENT_TEST_ADVERSARIAL_REVIEW_REMEDIATE_ACCEPT_COMMIT_GOVERNANCE"
    },
    "base_commit_oid": {
      "$ref": "#/$defs/gitOid"
    },
    "policy_bundle_digest": {
      "$ref": "#/$defs/sha256"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(sha1:[a-f0-9]{40}|sha256:[a-f0-9]{64})$"
    }
  }
}
