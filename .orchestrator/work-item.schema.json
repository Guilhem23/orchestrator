{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-fabric.example/schemas/orchestrator-v4-work-item.json",
  "title": "Slice Orchestrator v4 Work Item Record",
  "type": "object",
  "required": [
    "schema_version",
    "work_item_id",
    "run_id",
    "objective_id",
    "description",
    "type",
    "dependencies",
    "allowed_scope",
    "assigned_role",
    "worker_execution_id",
    "status",
    "input_artifacts",
    "output_artifacts",
    "acceptance_predicates",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^S[0-9]+-WI-[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "objective_id": {
      "type": "string",
      "pattern": "^S[0-9]+-O[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "analysis",
        "implementation",
        "test",
        "remediation",
        "review-support",
        "exploration"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S[0-9]+-WI-[0-9]+$"
      }
    },
    "allowed_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assigned_role": {
      "type": "string",
      "enum": [
        "PLANNER",
        "IMPLEMENTER",
        "ADVERSARIAL_REVIEWER",
        "REMEDIATOR",
        "EXPLORER",
        "GOVERNANCE_AGENT"
      ]
    },
    "worker_execution_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "READY",
        "IN_PROGRESS",
        "CONVERGENCE_CHECK",
        "SATISFIED",
        "BLOCKED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "output_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "acceptance_predicates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "predicate_id",
          "kind",
          "expression"
        ],
        "properties": {
          "predicate_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "test_pass",
              "file_exists",
              "schema_match",
              "benchmark_met",
              "evidence_exists",
              "protected_path_intact"
            ]
          },
          "expression": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
